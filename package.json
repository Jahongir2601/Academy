{
  "name": "markaziy-bank-akademiyasi-3d",
  "private": true,
  "version": "1.0.0",
  "description": "O‘zbekiston Markaziy Banki Akademiyasi kampusining interaktiv 3D maketi va simulyatsiyasi",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:artifact": "vite build && node scripts/make-artifact.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "export:glb": "node scripts/export-glb.mjs",
    "shots": "node scripts/screenshots.mjs",
    "textures": "python3 scripts/fetch_textures.py"
  },
  "dependencies": {
    "n8ao": "^2.0.1",
    "postprocessing": "^6.39.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright-core": "^1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
